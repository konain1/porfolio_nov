PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/kaunain_portfolio
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Secret used in the "x-admin-key" header to read messages / manage projects
ADMIN_KEY=change-this-to-a-long-random-string

# ---- Email ----
# Option A — Brevo HTTPS API (needed on Render's FREE plan, which blocks SMTP ports).
# Create a free account at brevo.com, verify MAIL_FROM as a sender, then
# SMTP & API → API Keys → generate a key. If set, Brevo is used instead of SMTP.
BREVO_API_KEY=
# Sender address (must be verified in Brevo; defaults to SMTP_USER)
MAIL_FROM=kaunainkasab@gmail.com

# Option B — Nodemailer over SMTP (local dev, or paid Render plans).
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kaunainkasab@gmail.com
SMTP_PASS=
# Where new-enquiry alerts are sent (defaults to SMTP_USER)
MAIL_TO=kaunainkasab@gmail.com
MAIL_FROM_NAME=Kaunain Kasab
OWNER_NAME=Kaunain Kasab
# Send a "thanks, I'll reply within 24h" email to the visitor
AUTO_REPLY=true
